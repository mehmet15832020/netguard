# NetGuard — Ortam Değişkenleri Şablonu
# Kullanım:
#   cp .env.example .env
#   # .env dosyasını düzenle, sonra:
#   docker compose up -d

# ── Zorunlu ───────────────────────────────────────────────────────────
# JWT imzalama anahtarı — openssl rand -hex 32
JWT_SECRET_KEY=BURAYA_GIZLI_ANAHTAR_YAZIN

# Dashboard şifreleri
ADMIN_PASSWORD=BURAYA_ADMIN_SIFRE_YAZIN
VIEWER_PASSWORD=BURAYA_VIEWER_SIFRE_YAZIN

# PostgreSQL
POSTGRES_PASSWORD=BURAYA_DB_SIFRE_YAZIN

# ── InfluxDB ──────────────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=BURAYA_INFLUXDB_TOKEN_YAZIN
INFLUXDB_ADMIN_PASSWORD=BURAYA_INFLUXDB_ADMIN_SIFRE_YAZIN
INFLUXDB_ORG=netguard
INFLUXDB_BUCKET=netguard

# ── Sunucu / Ağ ───────────────────────────────────────────────────────
# Tarayıcıdan erişilen IP ya da domain — örnek: 192.168.1.100
NETGUARD_HOST=localhost

# Syslog ve NetFlow port'ları (varsayılanlar çalışır, değiştirmeye gerek yok)
SYSLOG_PORT=5140
NETFLOW_PORT=2055

# pyshark için ağ arayüzü (Docker: eth0 | Bare-metal: ens33 / eth0)
NETGUARD_INTERFACE=eth0

# Zeek için ağ arayüzü (Docker içinde host arayüzünü görür)
ZEEK_INTERFACE=eth0

# Zeek log dizini (Docker volume ile otomatik paylaşılır, genellikle değiştirme)
ZEEK_LOG_DIR=/zeek-logs

# CORS — frontend URL'leri (virgülle ayrılmış)
NETGUARD_CORS_ORIGINS=https://localhost,https://127.0.0.1

# ── Aktif Yanıt (opsiyonel) ───────────────────────────────────────────
# OPNsense REST API (System > User Manager > API Keys)
OPNSENSE_HOST=
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_BLOCK_ALIAS=NETGUARD_BLOCK

# VyOS SSH (OPNsense yoksa fallback)
VYOS_HOST=
VYOS_USER=vyos
VYOS_KEY_PATH=/root/.ssh/id_ed25519
VYOS_FW_NAME=BLOCK-LIST

# Hiçbir zaman engellenmeyecek IP'ler (virgülle ayrılmış CIDR)
PROTECTED_CIDRS=

# Minimum incident severity (low / medium / high / critical)
BLOCK_MIN_SEVERITY=high

# Progressive TTL — saat cinsinden (1. ihlal, 2., 3., 4.+)
BLOCK_PROGRESSIVE_TTL=1,4,24,168

# Acil unblock token — openssl rand -hex 32
BREAK_GLASS_TOKEN=BURAYA_BREAK_GLASS_TOKEN_YAZIN

# FULL_ATTACK_CHAIN tespit edilince otomatik blok (0=kapalı, 1=açık)
AUTO_BLOCK_ON_FULL_CHAIN=0

# ── Bildirim (opsiyonel) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Discord veya Slack webhook URL
WEBHOOK_URL=
# Webhook tipi: discord veya slack
WEBHOOK_TYPE=discord

# ── Threat Intelligence (opsiyonel) ───────────────────────────────────
# https://www.abuseipdb.com/api adresinden ücretsiz API key alın
ABUSEIPDB_API_KEY=

# ── Log Retention (opsiyonel — varsayılanlar çalışır) ─────────────────
NETGUARD_RETAIN_NORMALIZED_DAYS=30
NETGUARD_RETAIN_SECURITY_DAYS=90
NETGUARD_RETAIN_CORRELATED_DAYS=365
NETGUARD_RETAIN_ALERTS_DAYS=90

# ── Döngü Aralıkları (opsiyonel — varsayılanlar çalışır) ──────────────
NETGUARD_CORR_INTERVAL=60        # saniye — korelasyon döngüsü
NETGUARD_DETECTOR_INTERVAL=30    # saniye — ağ saldırı dedektörleri
NETGUARD_SNMP_INTERVAL=60        # saniye — SNMP polling
NETGUARD_UPTIME_INTERVAL=60      # saniye — uptime checker
NETGUARD_NTP_CHECK_INTERVAL=300  # saniye — NTP saat doğrulaması
